# modules/user/packages.nix - User applications and terminal programs (home-manager)
{ pkgs, conf, inputs, ... }:

let
  userName = conf.user.name;
  system = pkgs.stdenv.hostPlatform.system;

  # Prebuilt Telegram Desktop fork (Material Design); avoids source builds.
  materialgram = pkgs.callPackage ../../pkgs/materialgram { };
  horizon-launcher = pkgs.callPackage ../../pkgs/horizon-launcher { };
in
{
  home-manager.users.${userName} = { lib, ... }: {
    # Use the packaged launcher (with its icon) instead of old userapp entries
    # generated by test runs, some of which point at disposable /tmp profiles.
    # Change only these two associations, preserving the user's other defaults.
    home.activation.materialgramMimeApps = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      run ${pkgs.xdg-utils}/bin/xdg-mime default io.github.kukuruzka165.materialgram.desktop x-scheme-handler/tg
      run ${pkgs.xdg-utils}/bin/xdg-mime default io.github.kukuruzka165.materialgram.desktop x-scheme-handler/tonsite
    '';

    home.packages = with pkgs; [
      # === From flake inputs ===
      inputs.firefox.packages.${system}.firefox-nightly-bin
      # inputs.ayugram-desktop.packages.${system}.ayugram-desktop

      # === Communication ===
      materialgram     # Telegram (prebuilt binary, Material Design)
      vesktop         # Discord (proxied)
      gajim           # XMPP

      # === Music ===
	  gapless

      # === Browsers ===
      chromium
      tor-browser

      # === Mail ===
      thunderbird

      # === Media ===
      transmission_4-gtk
      loupe

      # === Productivity ===
      libreoffice
      obsidian

      # === Graphics ===
      kdePackages.kolourpaint
      # aseprite
      pix

      # === Development ===
      android-studio
      opencode
      claude-code

      # === Gaming/Mods ===
      prismlauncher
      horizon-launcher
      # r2modman

      # === Wine ===
      winetricks
      wineWow64Packages.waylandFull

      # === Wayland tools ===
      wl-clipboard
      cliphist
      grim
      slurp
      swaybg

      # === Notifications ===
      libnotify
      swaynotificationcenter

      # === System utilities ===
      alsa-utils
      bluez
      bluetui
      wmctrl

      # === Terminal tools ===
      clock-rs
    ];

    programs = {
      # Terminals
      kitty.enable = true;
      alacritty.enable = true;

      # Rofi launcher
      rofi = {
        enable = true;
        package = pkgs.rofi;
        settings = {
          show-icons = true;
          modi = "run,drun,window,ssh";
          terminal = "alacritty";
          drun-display-format = "{icon} {name}";
          disable-history = false;
          hide-scrollbar = true;
          display-drun = "   Apps ";
          display-run = "   Run ";
          display-window = " 󰕰  Window ";
          display-ssh = " 󰴽  SSH ";
          sidebar-mode = true;
        };
      };
    };
  };
}
